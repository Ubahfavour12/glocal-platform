# Every name here is read somewhere in src/. If you add a variable to the code,
# add it here too: this file is what gets copied into Vercel, and a name that
# does not match the code fails silently at runtime rather than at build.

# ---------------------------------------------------------------- Supabase
# Project → Settings → API. The service-role key bypasses RLS: server only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The public origin, used to build smart links, OAuth redirects and the
# payment return URL. No trailing slash.
NEXT_PUBLIC_APP_URL=

# Shared secret the cron routes require in the Authorization header, so the
# nightly run cannot be triggered by anyone who finds the URL.
CRON_SECRET=

# ---------------------------------------------------------------- Payments
# Flutterwave: Dashboard → Settings → API Keys.
FLUTTERWAVE_SECRET_KEY=
# Dashboard → Settings → Webhooks → "Secret hash". Flutterwave echoes this
# verbatim in the `verif-hash` header. NOTE the name: the code reads
# FLUTTERWAVE_WEBHOOK_HASH, and webhook verification fails closed, so a
# mismatched name means top-ups are taken but wallets never credit.
FLUTTERWAVE_WEBHOOK_HASH=

# ---------------------------------------------------------------- Ad platforms
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_STAGING_BUSINESS_ID=
META_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---------------------------------------------------------------- Storefront
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# ---------------------------------------------------------------- AI
ANTHROPIC_API_KEY=

# Rendering. HIGGSFIELD IS THE PRIMARY ENGINE since 5 Nov 2026. Whichever
# engine leads, the other is failover; a free account gets one engine and no
# failover at all. Leave RENDER_PRIMARY blank for Higgsfield, or set "fal" to
# flip the order without a deploy. An unrecognised value falls back to
# Higgsfield rather than leaving the product with no primary.
RENDER_PRIMARY=

# Higgsfield. ONE of these is enough -- whichever shape your dashboard gives
# you. Higgsfield documents both a KEY_ID:KEY_SECRET pair (official SDK) and a
# single api key (quick-start); this account issues a single key.
#   HIGGSFIELD_API_KEY alone .................. a single key, OR a whole
#                                               "KEYID:SECRET" pasted into it
#   HIGGSFIELD_API_KEY + HIGGSFIELD_API_SECRET  the pair, joined with a colon
#   HIGGSFIELD_CREDENTIALS .................... overrides both, used verbatim
# Whatever resolves is sent as `Authorization: Key <value>`, unchanged.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_CREDENTIALS=

# Higgsfield addresses. Verified 5 Nov 2026 against the official SDK, EXCEPT
# the image endpoint's last segment -- see src/lib/higgsfield/client.ts.
# Overridable so a wrong address is a dashboard edit, not a deploy. A failed
# render names the status, the path it tried, and the variable to change.
#   HIGGSFIELD_BASE_URL   default https://api.higgsfield.ai        [confirmed]
#   HIGGSFIELD_VIDEO_PATH default /v1/image2video/dop              [confirmed]
#   HIGGSFIELD_POLL_PATH  default /requests/{id}/status            [confirmed]
#   HIGGSFIELD_IMAGE_PATH default /flux-pro/kontext/max/image-to-image
#                         ^ the Kontext family and the no-/v1 prefix are
#                           confirmed; "image-to-image" is inferred from the
#                           real "text-to-image" sibling. If it 404s, try
#                           /flux-pro/kontext/max/text-to-image
HIGGSFIELD_BASE_URL=
HIGGSFIELD_IMAGE_PATH=
HIGGSFIELD_VIDEO_PATH=
HIGGSFIELD_POLL_PATH=

# fal.ai: now the standby. Safe to leave blank -- with no key the engine list
# is Higgsfield alone and nothing tries to fail over.
FAL_KEY=
FAL_API_KEY=
FAL_BASE_URL=
FAL_IMAGE_MODEL=
FAL_VIDEO_MODEL=

# Set to "1" to let renders actually call the vendor. Unset means the lane
# runs in dry mode, which is what you want until billing is proven.
LIVE_AI=

# ---------------------------------------------------------------- Organic
METRICOOL_USER_ID=
METRICOOL_USER_TOKEN=

# ---------------------------------------------------------------- Research
YOUTUBE_DATA_API_KEY=

# ---------------------------------------------------------------- Email
# Optional. Receipts no-op cleanly without it, so it is safe to deploy first.
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=

# Founder console (/admin) — comma-separated exact addresses.
# UNSET MEANS NOBODY, deliberately: this page reads across every customer via
# the service role, so a missing variable must lock it, never open it.
FOUNDER_EMAILS=
