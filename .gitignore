# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. The example holds names only, never values, and it is the setup
# instructions for a new machine, so it has to be tracked.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Database exports. `npm run backup` writes here: every business, every user
# row, and the whole money ledger in plain JSON. It must never reach a remote,
# not even a private one — a backup is only a backup if it lives somewhere you
# control, and a git history is forever.
/backups
